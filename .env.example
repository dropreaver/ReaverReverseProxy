# Set at least one provider key. Each variable accepts one key or a comma-separated
# list for that provider, in rotation order (example: first-key,second-key).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional server-side file with one provider key per line, for example a local API.txt.
# PROVIDER_KEYS_FILE=API.txt

# A token can be shared. Each connecting IP has its own generation quota for that token.
PROXY_TOKENS=

# Exact browser origins, including scheme and non-default port. Separate with commas.
# Example for a local RisuAI development server at http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
PORT=3000

# Per proxy token and client IP, across both providers.
MAX_ACTIVE_PER_USER=8
REQUESTS_PER_MINUTE=3

# Per-request limits for model generation.
MAX_BODY_BYTES=33554432
OPENAI_MAX_INPUT_TOKENS=100000
OPENAI_MAX_OUTPUT_TOKENS=10000
ANTHROPIC_MAX_INPUT_TOKENS=100000
ANTHROPIC_MAX_OUTPUT_TOKENS=10000
