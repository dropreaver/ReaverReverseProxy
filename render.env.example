# reaver-proxy on Render
NODE_VERSION=24.22.3
SKIP_INSTALL_DEPS=true
ALLOWED_ORIGINS=https://risuai.xyz

# Set the keys for each provider you use. Separate multiple keys with commas.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Generate a private proxy token in Render and enter it in RisuAI.
PROXY_TOKENS=

# Token limits per generation request
OPENAI_MAX_INPUT_TOKENS=100000
OPENAI_MAX_OUTPUT_TOKENS=10000
ANTHROPIC_MAX_INPUT_TOKENS=100000
ANTHROPIC_MAX_OUTPUT_TOKENS=10000

# Request limits per proxy token and client IP, shared across providers
REQUESTS_PER_MINUTE=3
MAX_ACTIVE_PER_USER=8

# Maximum request body size in bytes (32 MiB)
MAX_BODY_BYTES=33554432
